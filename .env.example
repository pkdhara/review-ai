# Application
APP_NAME=ReviewAI
APP_ENV=development
APP_SECRET_KEY=your-secret-key-change-in-production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000,http://localhost

# Database
DATABASE_URL=postgresql+asyncpg://reviewai:reviewai_pass@127.0.0.1:5432/reviewai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=

# ─── LLM Provider Configuration ─────────────────
# Which LLM provider to use: antigravity | openai | gemini | anthropic
LLM_PROVIDER=antigravity

# Antigravity Local LLM Bridge (OpenAI-compatible RPC proxy on port 8899)
ANTIGRAVITY_MODEL=gemini-3.6-flash
ANTIGRAVITY_TIMEOUT_SECONDS=300
ALLOW_LLM_FALLBACK=false      # Set to true to allow fallback to public Gemini API keys on bridge failure

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=8192

# Google Gemini (Public API Key)
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-3.6-flash

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Default AI Provider (Legacy fallback if LLM_PROVIDER is unset)
AI_PROVIDER=antigravity

# Bitbucket Integration
BITBUCKET_BASE_URL=https://api.bitbucket.org/2.0
BITBUCKET_USERNAME=your-bitbucket-username
BITBUCKET_ACCESS_TOKEN=your-bitbucket-app-password-or-token
BITBUCKET_WORKSPACE=your-workspace-slug

# Jira Integration
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token

# Encryption key for storing secrets in DB (32 bytes base64)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=base64-encoded-32-byte-key

# Agent timeouts & concurrency
AGENT_TIMEOUT_SECONDS=120
MAX_CONCURRENT_REVIEWS=5

# Local Repositories Context (Git Worktree & AST Parsing)
LOCAL_REPO_BASE_DIR=/home/pradeep/fc
angular_repo=/home/pradeep/fc/fc-angular
jsp_repo=/home/pradeep/fc/freshconcepts
integration_repo=/home/pradeep/fc/freshconcepts-integration
mobile_repo=/home/pradeep/fc/fc-mobile-app
